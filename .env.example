# ===== Separate task-generation / task-review models =====
# Both profiles are required by the runtime. They may use different
# providers and models.
TASK_LLM_ADAPTER=
TASK_LLM_MODEL=
TASK_LLM_TEMPERATURE=0.0
TASK_LLM_API_KEY=

AUDIT_LLM_ADAPTER=
AUDIT_LLM_MODEL=
AUDIT_LLM_TEMPERATURE=0.0
AUDIT_LLM_API_KEY=

# If a profile API key is empty, the adapter-level key below is used as a
# backward-compatible fallback (for example GEMINI_API_KEY or OPENAI_API_KEY).

# ===== OpenAI =====
# Use this adapter with an OpenAI model, for example gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY_ENV=OPENAI_API_KEY
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_TOKENS=

# ===== DeepSeek =====
# DeepSeek uses the OpenAI-compatible Chat Completions API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=

# ===== Gemini =====
# The adapter/model are selected by TASK_LLM_ADAPTER/TASK_LLM_MODEL or
# AUDIT_LLM_ADAPTER/AUDIT_LLM_MODEL above.
GEMINI_API_KEY=

# GOOGLE_API_KEY is also supported by google-genai.
GOOGLE_API_KEY=

# ===== Codex CLI (local, Stage 3/4/6/7) =====
# Set the adapter to codex_cli to run Task generation / audit / dimension
# generation / regeneration through the locally installed `codex` binary:
#
#   TASK_LLM_ADAPTER=codex_cli
#   AUDIT_LLM_ADAPTER=codex_cli
#
# TASK_LLM_MODEL / AUDIT_LLM_MODEL may be left empty; codex then uses its own
# configured default model.
#
# CLI authentication is independent of this project: codex reads ~/.codex/auth.json
# and no value from this .env is ever forwarded to the CLI process.
CODEX_CLI_COMMAND=codex
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_TIMEOUT_SECONDS=600
CODEX_CLI_MAX_RETRIES=2
# Task reasoning should not be subject to local execpolicy .rules files.
CODEX_CLI_IGNORE_RULES=true
CODEX_CLI_IGNORE_USER_CONFIG=false

# ===== Gemini CLI (local, Stage 3/4/6/7) =====
# Set the adapter to gemini_cli to run Task generation / audit / dimension
# generation / regeneration through the locally installed `gemini` binary
# instead of the hosted API:
#
#   TASK_LLM_ADAPTER=gemini_cli
#   AUDIT_LLM_ADAPTER=gemini_cli
#
# TASK_LLM_MODEL / AUDIT_LLM_MODEL may be left empty; the CLI then uses its own
# default model.
#
# CLI authentication is independent of this project: no value from this .env is
# forwarded, so the CLI uses the account you signed in with and its own quota.
GEMINI_CLI_COMMAND=gemini
# 'plan' requires experimental.plan in the CLI settings; otherwise it warns and
# falls back to 'default'. Reasoning needs no tools, so 'default' is fine.
GEMINI_CLI_APPROVAL_MODE=default
GEMINI_CLI_TIMEOUT_SECONDS=300
GEMINI_CLI_MAX_RETRIES=2

# Which CLI engine Stage 2 uses to author analysis code (codex_cli/gemini_cli/claude_cli).
# Empty means: pick the first READY engine from allowed_cli_engines.
PREFLIGHT_CLI_ENGINE=

# ===== Ollama =====
# Example values for either profile:
# TASK_LLM_ADAPTER=ollama
# TASK_LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=5m
OLLAMA_THINK=false

# ===== LM Studio =====
# Start LM Studio local server first.
# Example values for either profile:
# TASK_LLM_ADAPTER=lmstudio
# TASK_LLM_MODEL=<model id returned by /v1/models>
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_TIMEOUT_SECONDS=120
LMSTUDIO_MAX_TOKENS=
LMSTUDIO_API_KEY=

# ===== Future external provider secrets =====
GOOGLE_APPLICATION_CREDENTIALS=
GMAIL_CREDENTIALS_JSON=
CUSTOM_API_TOKEN=

# ===== Runtime diagnostics =====
# INFO prints stage and count summaries. Use DEBUG for rejection reasons.
LOG_LEVEL=INFO
# Save the generated prompt immediately before each real LLM request.
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_DIR=log
# Optional override for tests or isolated runs.
TASK_CLOSED_LOOP_LOG_DIR=log
